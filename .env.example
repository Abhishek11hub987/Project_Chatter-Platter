# ============================================================================
# CHATTER & PLATTER CAFE — ENVIRONMENT CONFIGURATION
# Copy this file to `.env.local` and fill in your own credentials.
# Do NOT commit `.env.local` to version control.
# Leave cloud database values blank to run in Built-in Persistent Cafe Disk DB mode!
# ============================================================================

# Option A: Supabase (PostgreSQL + Auth + Realtime)
# Run `supabase_schema.sql` in your Supabase SQL Editor first.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Option B: Firebase Realtime Database (Free Spark Plan alternative)
# Example: https://your-project-default-rtdb.firebaseio.com
VITE_FIREBASE_DB_URL=

# Staff Terminal PINs (for /?role=reception and /?role=chef routes)
# Change these before deploying in production!
VITE_RECEPTION_PIN=1234
VITE_CHEF_PIN=5678
